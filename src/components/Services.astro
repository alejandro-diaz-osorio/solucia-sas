---
import {
    PencilRuler,
    Map,
    Cog,
    Building,
    FileText,
    BriefcaseBusiness,
} from "@lucide/astro"

const services = [
    { label: "Diseño Arquitectónico", icon: PencilRuler },
    { label: "Diseño Urbano", icon: Map },
    { label: "Cálculo Estructural", icon: Cog },
    { label: "Construcción", icon: Building },
    { label: "Trámite de Licencias", icon: FileText },
    { label: "Comercialización", icon: BriefcaseBusiness },
]
---

<section
    id="servicios"
    class="border-b border-gray-300/60 py-12"
    aria-labelledby="services-title"
>
    <h2
        id="services-title"
        class="mb-8 text-lg font-bold uppercase tracking-wider text-slate-900"
    >
        Nuestros Servicios
    </h2>

    <div
        class="grid grid-cols-2 gap-6 text-center md:grid-cols-3 lg:grid-cols-6"
    >
        {
            services.map(({ label, icon: Icon }) => (
                <div class="group space-y-2 transition-transform duration-300 hover:scale-105">
                    <div class="flex justify-center text-slate-800 transition-colors duration-300 group-hover:text-[#c23b22]">
                        <Icon size="48" />
                    </div>
                    <h3 class="text-xs font-bold uppercase text-slate-900 transition-colors duration-300 group-hover:text-[#c23b22]">
                        {label}
                    </h3>
                </div>
            ))
        }
    </div>
</section>
