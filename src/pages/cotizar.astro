---
import BaseLayout from "../layouts/BaseLayout.astro"
import Footer from "../components/Footer.astro"
import Header from "../components/Header.astro"
---

<BaseLayout
    title="Cotizar proyecto | SOLUCIA"
    description="Cuéntanos sobre tu proyecto de arquitectura y construcción."
>
    <Header />

    <main class="mx-auto max-w-7xl px-6 py-8">
        <section
            class="grid gap-10 border-b border-gray-300/60 py-16 md:grid-cols-[0.8fr_1.2fr] md:items-start"
        >
            <div class="space-y-5">
                <p
                    class="text-xs font-bold uppercase tracking-wider text-[#c23b22]"
                >
                    Hablemos de tu proyecto
                </p>
                <h1
                    class="max-w-md text-3xl font-extrabold uppercase leading-tight text-slate-900 lg:text-4xl"
                >
                    Solicita una cotización
                </h1>
                <p class="max-w-md text-sm leading-relaxed text-slate-600">
                    Cuéntanos qué tienes en mente. Revisaremos la información y
                    nos pondremos en contacto contigo para conversar sobre el
                    siguiente paso.
                </p>

                <a
                    href="/"
                    class="inline-block text-sm font-semibold
                    text-[#c23b22] transition-colors hover:text-red-700"
                >
                    ← Volver al inicio
                </a>
            </div>
            <form
                id="cotizar-form"
                class="grid gap-5 rounded-sm bg-white p-6 shadow-sm md:grid-cols-2"
            >
                <input
                    type="hidden"
                    name="access_key"
                    value="ce40e2c8-c244-4810-90bf-d27a1acc1ce5"
                />
                <input
                    type="hidden"
                    name="subject"
                    value="Nueva solicitud de cotización — SOLUCIA"
                />
                <input
                    type="checkbox"
                    name="botcheck"
                    class="hidden"
                    style="display:none"
                />

                <label
                    class="grid gap-2 text-xs font-bold uppercase tracking-wide text-slate-700"
                >
                    Nombre
                    <input
                        required
                        type="text"
                        name="name"
                        class="border border-gray-300 px-3 py-3 text-sm font-normal normal-case outline-none transition-colors focus:border-[#c23b22]"
                    />
                </label>
                <label
                    class="grid gap-2 text-xs font-bold uppercase tracking-wide text-slate-700"
                >
                    Correo electrónico
                    <input
                        required
                        type="email"
                        name="email"
                        class="border border-gray-300 px-3 py-3 text-sm font-normal normal-case outline-none transition-colors focus:border-[#c23b22]"
                    />
                </label>
                <label
                    class="grid gap-2 text-xs font-bold uppercase tracking-wide text-slate-700 md:col-span-2"
                >
                    Tipo de proyecto
                    <select
                        name="tipo"
                        class="border border-gray-300 bg-white px-3 py-3 text-sm font-normal normal-case outline-none transition-colors focus:border-[#c23b22]"
                    >
                        <option>Diseño arquitectónico</option>
                        <option>Construcción</option>
                        <option>Trámite de licencias</option>
                        <option>Otro</option>
                    </select>
                </label>
                <label
                    class="grid gap-2 text-xs font-bold uppercase tracking-wide text-slate-700 md:col-span-2"
                >
                    Cuéntanos más
                    <textarea
                        required
                        name="message"
                        rows="5"
                        class="resize-y border border-gray-300 px-3 py-3 text-sm font-normal normal-case outline-none transition-colors focus:border-[#c23b22]"
                    ></textarea>
                </label>

                <button
                    type="submit"
                    class="w-fit rounded-sm bg-[#c23b22] px-6 py-3 text-xs font-semibold text-white transition-colors hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-60"
                >
                    ENVIAR SOLICITUD
                </button>

                <p
                    id="form-status"
                    class="text-sm md:col-span-2"
                    aria-live="polite"
                >
                </p>
            </form>
        </section>
    </main>
</BaseLayout>

<Footer />

<script>
    const form = document.getElementById("cotizar-form") as HTMLFormElement
    const status = document.getElementById(
        "form-status",
    ) as HTMLParagraphElement
    const button = form.querySelector(
        "button[type='submit']",
    ) as HTMLButtonElement

    form.addEventListener("submit", async (e) => {
        e.preventDefault()

        button.disabled = true
        button.textContent = "ENVIANDO..."
        status.textContent = ""
        status.className = "text-sm md:col-span-2"

        try {
            const response = await fetch("https://api.web3forms.com/submit", {
                method: "POST",
                body: new FormData(form),
            })

            const data = await response.json()

            if (!data.success) {
                throw new Error(
                    data.message || "Error al enviar el formulario.",
                )
            }

            status.textContent =
                "¡Gracias! Tu solicitud fue enviada. Te contactaremos pronto."
            status.classList.add("text-green-600")
            form.reset()
        } catch (error) {
            status.textContent =
                error instanceof Error
                    ? error.message
                    : "Ocurrió un error. Intenta de nuevo."
            status.classList.add("text-red-600")
        } finally {
            button.disabled = false
            button.textContent = "ENVIAR SOLICITUD"
        }
    })
</script>
